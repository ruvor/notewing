{
  "name": "notewing",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown notes in your own GitHub repository. No server, works offline.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test test/unit/repo.test.ts test/unit/ui.test.ts",
    "test:e2e": "node --import tsx test/e2e/run.mjs --browser=all"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@preact/signals": "^2.11.2",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.2",
    "puppeteer": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
